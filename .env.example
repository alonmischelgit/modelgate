PORT=3200

# --- Redis -------------------------------------------------------------------
# Shared state for the cache, rate limiter, budgets and circuit breaker.
# Required for CORRECTNESS with more than one gateway instance: with in-process
# counters, N replicas enforce N times the rate limit and N times the daily
# budget, and nothing errors to tell you. Leave unset to run single-instance
# with in-memory state for local dev - the service logs a warning and reports
# `store: "memory"` on /v1/stats when it does.
REDIS_URL=redis://localhost:6379

# --- Providers ---------------------------------------------------------------
# Keys only. WHICH provider serves a request is decided per request by the model
# registry (src/providers/registry.ts), not by config.
#
# A Google AI Studio key (https://aistudio.google.com/apikey) created in a
# project with NO billing account attached cannot be charged - exceeding the
# quota returns 429, never an invoice. The free tier covers the Flash models;
# Pro models return 429.
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# The mock providers are always registered, so routing, failover, the circuit
# breaker and the rate limiter are all demonstrable with no keys at all.
DEFAULT_MODEL=mock-small

# --- Policy (per tenant) -----------------------------------------------------
RATE_LIMIT_PER_MIN=60
BUDGET_USD_PER_DAY=5
CACHE_TTL_SECONDS=300
REQUEST_TIMEOUT_MS=30000      # per provider attempt (one-shot)
REQUEST_DEADLINE_MS=60000     # for the whole request - retries and failover included
TTFT_TIMEOUT_MS=30000         # streaming: how long until the first token (retry/failover apply until then). Free-tier Gemini queues up to ~30s; on a paid tier set this LOW (5s) so failover is fast
STREAM_IDLE_TIMEOUT_MS=30000  # streaming: max silence between tokens once committed
DEFAULT_MAX_TOKENS=1024       # when the caller doesn't say; same for every provider

# --- Reliability (per provider) ----------------------------------------------
MAX_ATTEMPTS=3            # retries before failing over to the next route step
BASE_BACKOFF_MS=200       # exponential: 200, 400, 800... plus jitter
BREAKER_THRESHOLD=5       # consecutive 5xx/timeouts before the circuit opens (429s don't count)
BREAKER_COOLDOWN_SEC=30   # how long it stays open before a trial request
